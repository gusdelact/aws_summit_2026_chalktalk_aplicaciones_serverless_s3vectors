        <mxCell id="n7d" value="Imprime resultados ordenados por&#10;similitud (menor distancia primero):&#10;key, distancia, categoria, texto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="laneScript">
