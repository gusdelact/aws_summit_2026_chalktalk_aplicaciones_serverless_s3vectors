        <mxCell id="s4" value="(Detrás de escena, gestionado&#10;por el Knowledge Base)&#10;&#10;Bedrock genera embeddings de&#10;cada documento y los guarda en&#10;Amazon S3 Vectors (vector index&#10;creado por el stack CDK)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;fontStyle=1" vertex="1" parent="laneAWS">
