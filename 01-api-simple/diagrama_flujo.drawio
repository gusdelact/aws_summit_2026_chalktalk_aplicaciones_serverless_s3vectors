      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Flujo del script simple_s3_vectors_demo.py&#10;(Demo simple de la API Amazon S3 Vectors, sin CDK, sin Bedrock Knowledge Bases)" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="1200" height="40" as="geometry" />
        </mxCell>

        <!-- Left swimlane: script -->
        <mxCell id="laneScript" value="Script Python (boto3) &#10;simple_s3_vectors_demo.py" style="swimlane;fontStyle=1;fontSize=13;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="480" height="1150" as="geometry" />
        </mxCell>

        <mxCell id="n1" value="main()&#10;Parsea argumentos CLI:&#10;--profile --region --bucket&#10;--indice --consulta --cleanup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="laneScript">
          <mxGeometry x="40" y="50" width="400" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n2" value="boto3.Session(profile, region)&#10;Crea clientes:&#10;s3vectors  y  bedrock-runtime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="laneScript">
          <mxGeometry x="40" y="150" width="400" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n3" value="crear_bucket_e_indice()&#10;1. create_vector_bucket(nombre_bucket)&#10;2. create_index(dimension=1024,&#10;   distanceMetric=&quot;cosine&quot;,&#10;   nonFilterableMetadataKeys=[&quot;texto&quot;])" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneScript">
          <mxGeometry x="40" y="240" width="400" height="90" as="geometry" />
        </mxCell>

        <mxCell id="n4" value="time.sleep(2)&#10;(espera consistencia eventual del índice)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="laneScript">
          <mxGeometry x="40" y="360" width="400" height="45" as="geometry" />
        </mxCell>

        <mxCell id="n5" value="ingestar_documentos()&#10;Para cada uno de los 8 DOCUMENTOS_EJEMPLO&#10;(bebida, electronica, musica, animal):" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="laneScript">
          <mxGeometry x="40" y="435" width="400" height="55" as="geometry" />
        </mxCell>

        <mxCell id="n5b" value="generar_embedding(texto)&#10;→ construye vector float32[1024]&#10;   por documento" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="laneScript">
          <mxGeometry x="40" y="510" width="400" height="55" as="geometry" />
        </mxCell>

        <mxCell id="n5c" value="s3vectors.put_vectors()&#10;Inserta los 8 vectores con&#10;key + data(float32) + metadata&#10;(categoria, texto)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneScript">
          <mxGeometry x="40" y="585" width="400" height="65" as="geometry" />
        </mxCell>

        <mxCell id="n6" value="time.sleep(2)&#10;(espera consistencia eventual tras la ingesta)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="laneScript">
          <mxGeometry x="40" y="670" width="400" height="45" as="geometry" />
