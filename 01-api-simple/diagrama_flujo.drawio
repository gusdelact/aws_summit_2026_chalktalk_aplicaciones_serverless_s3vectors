          <mxGeometry x="40" y="810" width="400" height="50" as="geometry" />
        </mxCell>

        <mxCell id="n7c" value="s3vectors.query_vectors()&#10;topK=3, returnDistance=True,&#10;returnMetadata=True" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneScript">
          <mxGeometry x="40" y="880" width="400" height="55" as="geometry" />
