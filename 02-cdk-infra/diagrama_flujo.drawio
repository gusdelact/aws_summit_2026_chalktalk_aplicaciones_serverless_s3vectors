<mxfile host="Electron" agent="Kiro" version="24.0.0">
  <diagram name="Flujo de construccion - demo_stack.py" id="flujo-cdk-stack">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Orden de construcción de recursos - DemoS3VectorsStack (02-cdk-infra)&#10;app.py instancia el stack -&gt; demo_stack.py define y encadena los recursos" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="1200" height="45" as="geometry" />
        </mxCell>

        <mxCell id="n0" value="app.py&#10;cdk.App() → DemoS3VectorsStack(app,&#10;&quot;DemoS3VectorsStack&quot;, env=account/region)&#10;→ app.synth()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="440" y="60" width="400" height="65" as="geometry" />
        </mxCell>

        <mxCell id="n1" value="1. DataSourceBucket (s3.Bucket)&#10;stg302-libros-datos-{account}-{region}&#10;RemovalPolicy=DESTROY, autoDeleteObjects=True&#10;BlockPublicAccess=BLOCK_ALL, enforceSSL=True" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="80" y="160" width="360" height="80" as="geometry" />
        </mxCell>

        <mxCell id="n2" value="2. VectorBucket (s3vectors.CfnVectorBucket)&#10;vectorBucketName=&#10;stg302-libros-vector-bucket" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="480" y="160" width="360" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n3" value="3. VectorIndex (s3vectors.CfnIndex)&#10;indexName=stg302-libros-index-v2&#10;dataType=float32, dimension=1024,&#10;distanceMetric=cosine&#10;nonFilterableMetadataKeys=&#10;[AMAZON_BEDROCK_TEXT, AMAZON_BEDROCK_METADATA]&#10;&#10;add_resource_dependency(VectorBucket)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="480" y="250" width="360" height="120" as="geometry" />
        </mxCell>

        <mxCell id="n4" value="4. KnowledgeBaseRole (iam.Role)&#10;assumedBy=bedrock.amazonaws.com&#10;condiciones: SourceAccount + SourceArn&#10;(scoped a knowledge-base/*)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="880" y="160" width="340" height="75" as="geometry" />
        </mxCell>

        <mxCell id="n4a" value="4a. grant_read(kb_role)&#10;sobre DataSourceBucket" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="880" y="250" width="160" height="50" as="geometry" />
        </mxCell>

        <mxCell id="n4b" value="4b. PolicyStatement&#10;S3VectorsAccess:&#10;GetIndex, GetVectorBucket, PutVectors,&#10;GetVectors, DeleteVectors, ListVectors,&#10;QueryVectors&#10;sobre vectorBucketArn + indexArn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1060" y="250" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="n4c" value="4c. PolicyStatement&#10;InvokeEmbeddingModel:&#10;bedrock:InvokeModel sobre&#10;foundation-model/&#10;amazon.titan-embed-text-v2:0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="880" y="370" width="340" height="80" as="geometry" />
        </mxCell>

        <mxCell id="n5" value="5. KnowledgeBase (bedrock.CfnKnowledgeBase)&#10;name=stg302-libros-ciencia-datos-kb&#10;type=VECTOR, roleArn=kb_role.roleArn&#10;embeddingModel=Titan Embed v2&#10;(1024 dim, FLOAT32)&#10;storage=S3_VECTORS&#10;(vectorBucketArn + indexArn)&#10;&#10;add_dependency(VectorIndex)&#10;add_dependency(KnowledgeBaseRole)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="480" y="480" width="400" height="160" as="geometry" />
        </mxCell>

        <mxCell id="n6" value="6. DataSource (bedrock.CfnDataSource)&#10;name=stg302-libros-datasource&#10;knowledgeBaseId=KnowledgeBase.attr_id&#10;type=S3, bucketArn=DataSourceBucket&#10;&#10;chunking HIERARCHICAL:&#10;niveles [1500, 300] tokens&#10;overlapTokens=60&#10;&#10;add_dependency(KnowledgeBase)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="480" y="680" width="400" height="140" as="geometry" />
        </mxCell>

        <mxCell id="n7" value="7. CfnOutput x7&#10;DataSourceBucketName, VectorBucketArn,&#10;VectorIndexArn, KnowledgeBaseId,&#10;KnowledgeBaseArn, DataSourceId,&#10;KnowledgeBaseRoleArn&#10;&#10;→ consumidos por 03-ingesta/&#10;subir_e_ingestar.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="480" y="860" width="400" height="130" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="Leyenda:&#10;Verde = S3 / S3 Vectors&#10;Rojo = IAM&#10;Naranja = Bedrock&#10;Morado = Outputs de CloudFormation" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="1030" width="320" height="90" as="geometry" />
        </mxCell>

