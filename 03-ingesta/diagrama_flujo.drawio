<mxfile host="Electron" agent="Kiro" version="24.0.0">
  <diagram name="Flujo subir_e_ingestar.py" id="flujo-ingesta">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Flujo del script subir_e_ingestar.py&#10;(Sube documentos a S3 y dispara la ingesta del Knowledge Base de Bedrock)" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="1200" height="40" as="geometry" />
        </mxCell>

        <!-- Left swimlane: script -->
        <mxCell id="laneScript" value="Script Python (boto3)&#10;subir_e_ingestar.py" style="swimlane;fontStyle=1;fontSize=13;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="480" height="1170" as="geometry" />
        </mxCell>

        <mxCell id="n1" value="main()&#10;Parsea argumentos CLI:&#10;--profile --region --docs-dir&#10;--stack-name --solo-subir&#10;--solo-ingestar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="laneScript">
          <mxGeometry x="40" y="50" width="400" height="80" as="geometry" />
        </mxCell>

        <mxCell id="n2" value="boto3.Session(profile, region)&#10;Crea clientes:&#10;cloudformation, s3, bedrock-agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="laneScript">
          <mxGeometry x="40" y="150" width="400" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n3" value="obtener_outputs_stack()&#10;cf_client.describe_stacks(&quot;DemoS3VectorsStack&quot;)&#10;Lee outputs:&#10;DataSourceBucketName,&#10;KnowledgeBaseId, DataSourceId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneScript">
          <mxGeometry x="40" y="240" width="400" height="90" as="geometry" />
        </mxCell>

        <mxCell id="n4" value="¿faltan outputs?&#10;sys.exit(...) si el stack&#10;no existe o falta algún output" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="laneScript">
          <mxGeometry x="120" y="345" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n5" value="¿--solo-ingestar?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="laneScript">
          <mxGeometry x="120" y="435" width="240" height="55" as="geometry" />
        </mxCell>

        <mxCell id="n6" value="subir_documentos()&#10;Busca *.md recursivo en docs_dir&#10;(los 5 libros de ciencia de datos)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="laneScript">
          <mxGeometry x="40" y="520" width="400" height="55" as="geometry" />
        </mxCell>

        <mxCell id="n6b" value="Por cada .md:&#10;s3_client.upload_file()&#10;key = ruta relativa&#10;(ej. capitulos_fes/01_Introduction.md)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneScript">
          <mxGeometry x="40" y="595" width="400" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n6c" value="Imprime progreso cada 10 archivos&#10;(ej. 98 documentos subidos)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="laneScript">
          <mxGeometry x="40" y="685" width="400" height="45" as="geometry" />
        </mxCell>

        <mxCell id="n7" value="¿--solo-subir?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="laneScript">
          <mxGeometry x="120" y="750" width="240" height="55" as="geometry" />
        </mxCell>

        <mxCell id="n8" value="Termina: imprime&#10;&quot;no se disparó el ingestion job&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="laneScript">
          <mxGeometry x="260" y="830" width="180" height="55" as="geometry" />
        </mxCell>

        <mxCell id="n9" value="iniciar_ingestion_job()&#10;bedrock_agent_client.&#10;start_ingestion_job(knowledgeBaseId,&#10;dataSourceId, description)&#10;→ devuelve ingestionJobId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneScript">
          <mxGeometry x="40" y="830" width="180" height="90" as="geometry" />
        </mxCell>

        <mxCell id="n10" value="esperar_ingestion_job()&#10;Polling cada 15s:&#10;get_ingestion_job()&#10;Imprime estado + estadísticas&#10;(escaneados, nuevos, modificados,&#10;fallidos)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneScript">
          <mxGeometry x="40" y="940" width="400" height="95" as="geometry" />
        </mxCell>

        <mxCell id="n11" value="¿estado == COMPLETE?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="laneScript">
          <mxGeometry x="120" y="1050" width="240" height="55" as="geometry" />
